<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_row_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_vs_badge"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivTeamLogo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Arsenal"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPlayed"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="12"
        android:textColor="#CBD5E1"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvWon"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="9"
        android:textColor="#4ADE80"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvDrawn"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="2"
        android:textColor="#94A3B8"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvLost"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="#F87171"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvGoalDiff"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="+18"
        android:textColor="#E2E8F0"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvPoints"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="29"
        android:textColor="#38BDF8"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
