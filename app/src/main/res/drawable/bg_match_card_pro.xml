<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1B2A47"
                android:endColor="#0F192E" />
            <corners android:radius="18dp" />
            <stroke android:width="2.5dp" android:color="#38BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#11192B"
                android:endColor="#0A101D" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#1E2C47" />
        </shape>
    </item>
</selector>
