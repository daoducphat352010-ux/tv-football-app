<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#16243D"
                android:endColor="#0F172A" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2.5dp"
                android:color="#38BDF8" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#16243D" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#38BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#11192C"
                android:endColor="#0B1120" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#1E293B" />
        </shape>
    </item>
</selector>
